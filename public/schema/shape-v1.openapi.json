            "title": "Outerheight",
            "type": "integer"
          },
          "devicePixelRatio": {
            "default": 1.0,
            "maximum": 16,
            "minimum": 0.1,
            "title": "Devicepixelratio",
            "type": "number"
          },
          "screenX": {
            "default": 0,
            "title": "Screenx",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenY": {
            "default": 0,
            "title": "Screeny",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenLeft": {
            "default": 0,
            "title": "Screenleft",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenTop": {
            "default": 0,
            "title": "Screentop",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageXOffset": {
            "default": 0,
            "title": "Pagexoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageYOffset": {
            "default": 0,
            "title": "Pageyoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "title": "Window",
        "type": "object"
      },
      "ShapeRequest": {
        "additionalProperties": false,
        "properties": {
          "source_url": {
            "title": "Source Url",
            "type": "string",
            "description": "Context only; never fetched. Required for uploads and references; must match cached source URL."
          },
          "scripts": {
            "items": {
              "$ref": "#/components/schemas/Script"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "description": "Ordered client-supplied scripts. At most 16; 2 MiB each and 3 MiB total UTF-8 source."
          },
          "material_ref": {
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/BrowserProfile"
          },
          "request": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "document_cookie": {
            "default": "",
            "title": "Document Cookie",
            "type": "string",
            "description": "JavaScript-visible cookies only, at most 16 KiB; never retained in material cache."
          }
        },
        "required": [
          "source_url",
          "profile",
          "request"
        ],
        "title": "ShapeRequest",
        "type": "object",
        "oneOf": [
          {
            "required": [
              "scripts"
            ],
            "not": {
              "required": [
                "material_ref"
              ]
            }
          },
          {
            "required": [
              "material_ref"
            ],
            "not": {
              "required": [
                "scripts"
              ]
            }
          }
        ]
      },
      "ShapeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headers",
          "request_id",
          "generation_ms",
          "profile_used",
          "material_ref",
          "material_expires_at"
        ],
        "properties": {
          "headers": {
            "type": "object",
            "minProperties": 6,
            "maxProperties": 6,
            "patternProperties": {
              "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}-[abcdfz]$": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Complete customer-specific same-prefix a/b/c/d/f/z family. Header names use valid HTTP token characters and need no X- prefix. Values contain only ASCII bytes 0x21 through 0x7e with no whitespace; d may be empty. Generation does not assert target acceptance."
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation_ms": {
            "type": "integer",
            "minimum": 0
          },
          "profile_used": {
            "$ref": "#/components/schemas/BrowserProfile",
            "description": "Effective supported browser identity; canvas pixels and document cookies are excluded."
          },
          "material_ref": {
            "type": "string"
          },
          "material_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Five-minute immutable material expiry, UTC. References are scoped to this API key."
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "limits",
          "allowance"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "daily_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Legacy admitted-attempt analytics only; no daily or monthly cap is enforced.",
            "deprecated": true
          },
          "monthly_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Legacy admitted-attempt analytics only; no daily or monthly cap is enforced.",
            "deprecated": true
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requests_per_second"
            ],
            "properties": {
              "requests_per_second": {
                "type": "number",
                "minimum": 0.016666666666666666,
                "maximum": 15
              }
            }
          },
          "allowance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "weekly_limit",
              "weekly_used",
              "weekly_remaining",
              "weekly_resets_at",
              "prepaid_remaining",
              "wallet",
              "payg_rate_per_1000_usd"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "owner",
                  "custom",
                  "subscription",
                  "prepaid",
                  "wallet"
                ]
              },
              "weekly_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "weekly_used": {
                "type": "integer",
                "minimum": 0,
                "description": "Spent and currently reserved calls in the current allowance period."
              },
              "weekly_remaining": {
                "type": "integer",
                "minimum": 0
              },
              "weekly_resets_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "prepaid_remaining": {
                "type": "integer",
                "minimum": 0,
                "description": "Deprecated standard-rate call equivalent of available wallet funds ($5 per 1,000); use wallet.balance_usd and the current PAYG rate. Deferred legacy conversions may still expose their original call count.",
                "deprecated": true
              },
              "wallet": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "balance_usd",
                  "balance_micro_usd"
                ],
                "properties": {
                  "balance_usd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Available preloaded USD wallet funds."
                  },
                  "balance_micro_usd": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Exact available balance in millionths of one USD."
                  }
                }
              },
              "payg_rate_per_1000_usd": {
                "type": "number",
                "enum": [
                  5,
                  3.5,
                  2.5,
                  2,
                  1.5
                ],
                "description": "Standard PAYG or the newest eligible paid period rate per 1,000 successful generations, after weekly allowance."
              },
              "legacy_prepaid_deprecated": {
                "type": "boolean",
                "const": true,
                "description": "Legacy prepaid-call fields are deprecated; display authoritative wallet funds."
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "request_id"
            ],
