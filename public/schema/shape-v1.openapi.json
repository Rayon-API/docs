          },
          "vendor": {
            "default": "Google Inc.",
            "maxLength": 8192,
            "title": "Vendor",
            "type": "string"
          },
          "appVersion": {
            "default": "5.0",
            "maxLength": 8192,
            "title": "Appversion",
            "type": "string"
          },
          "appCodeName": {
            "default": "Mozilla",
            "maxLength": 8192,
            "title": "Appcodename",
            "type": "string"
          },
          "appName": {
            "default": "Netscape",
            "maxLength": 8192,
            "title": "Appname",
            "type": "string"
          },
          "product": {
            "default": "Gecko",
            "maxLength": 8192,
            "title": "Product",
            "type": "string"
          },
          "language": {
            "default": "en-US",
            "maxLength": 8192,
            "title": "Language",
            "type": "string"
          },
          "languages": {
            "default": [
              "en-US",
              "en"
            ],
            "items": {
              "maxLength": 8192,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "hardwareConcurrency": {
            "default": 8,
            "maximum": 1024,
            "minimum": 1,
