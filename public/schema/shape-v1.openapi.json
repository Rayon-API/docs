            "default": "Mozilla/5.0",
            "maxLength": 8192,
            "title": "Useragent",
            "type": "string"
          },
          "platform": {
            "default": "MacIntel",
            "maxLength": 8192,
            "title": "Platform",
            "type": "string"
          },
          "vendor": {
            "default": "Google Inc.",
            "maxLength": 8192,
            "title": "Vendor",
            "type": "string"
          },
          "appVersion": {
            "default": "5.0",
            "maxLength": 8192,
            "title": "Appversion",
            "type": "string"
          },
          "appCodeName": {
            "default": "Mozilla",
            "maxLength": 8192,
            "title": "Appcodename",
            "type": "string"
          },
          "appName": {
            "default": "Netscape",
            "maxLength": 8192,
            "title": "Appname",
            "type": "string"
          },
          "product": {
            "default": "Gecko",
            "maxLength": 8192,
            "title": "Product",
            "type": "string"
          },
          "language": {
            "default": "en-US",
            "maxLength": 8192,
            "title": "Language",
            "type": "string"
          },
          "languages": {
            "default": [
              "en-US",
              "en"
            ],
            "items": {
              "maxLength": 8192,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "hardwareConcurrency": {
            "default": 8,
            "maximum": 1024,
            "minimum": 1,
            "title": "Hardwareconcurrency",
            "type": "integer"
          },
          "maxTouchPoints": {
            "default": 0,
            "maximum": 100,
            "minimum": 0,
            "title": "Maxtouchpoints",
            "type": "integer"
          },
          "webdriver": {
            "default": false,
            "title": "Webdriver",
            "type": "boolean"
          },
          "cookieEnabled": {
            "default": true,
            "title": "Cookieenabled",
            "type": "boolean"
          },
          "doNotTrack": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Donottrack"
          }
        },
        "title": "Navigator",
        "type": "object"
      },
      "RequestContext": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "content_type": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          }
        },
        "required": [
          "url",
          "method",
          "content_type",
          "body"
        ],
        "title": "RequestContext",
        "type": "object"
      },
      "Screen": {
        "additionalProperties": false,
        "properties": {
          "width": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Width",
            "type": "integer"
          },
          "height": {
            "default": 1080,
            "maximum": 32768,
            "minimum": 1,
            "title": "Height",
            "type": "integer"
          },
          "availWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 0,
            "title": "Availwidth",
            "type": "integer"
          },
          "availHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 0,
            "title": "Availheight",
            "type": "integer"
          },
          "colorDepth": {
            "default": 24,
            "maximum": 64,
            "minimum": 1,
            "title": "Colordepth",
            "type": "integer"
          },
          "pixelDepth": {
            "default": 24,
            "maximum": 64,
            "minimum": 1,
            "title": "Pixeldepth",
            "type": "integer"
          }
        },
        "title": "Screen",
        "type": "object"
      },
