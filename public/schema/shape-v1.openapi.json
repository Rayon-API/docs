            "maxLength": 8192,
            "title": "Platform",
            "type": "string"
          },
          "language": {
            "default": "en-US",
            "maxLength": 8192,
            "title": "Language",
            "type": "string"
          },
          "languages": {
            "default": [
              "en-US",
              "en"
            ],
            "items": {
              "maxLength": 8192,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "screen": {
            "$ref": "#/components/schemas/Screen"
          },
          "window": {
            "$ref": "#/components/schemas/Window"
          },
          "webgl": {
