            "type": "integer"
          },
          "innerHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 1,
            "title": "Innerheight",
            "type": "integer"
          },
          "outerWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
