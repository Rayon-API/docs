            "title": "Availwidth",
            "type": "integer"
          },
          "availHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 0,
            "title": "Availheight",
            "type": "integer"
          },
          "colorDepth": {
            "default": 24,
            "maximum": 64,
            "minimum": 1,
