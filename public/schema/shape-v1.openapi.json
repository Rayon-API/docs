        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "url",
          "source"
        ],
        "title": "Script",
        "type": "object"
      },
      "WebGL": {
        "additionalProperties": false,
        "properties": {
          "renderer": {
            "default": "Sandbox Renderer",
            "maxLength": 8192,
            "title": "Renderer",
            "type": "string"
          },
          "vendor": {
            "default": "Google Inc.",
            "maxLength": 8192,
            "title": "Vendor",
            "type": "string"
          }
        },
        "title": "WebGL",
        "type": "object"
      },
      "Window": {
        "additionalProperties": false,
        "properties": {
          "innerWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Innerwidth",
            "type": "integer"
          },
          "innerHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 1,
            "title": "Innerheight",
            "type": "integer"
          },
          "outerWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Outerwidth",
            "type": "integer"
          },
          "outerHeight": {
            "default": 1080,
            "maximum": 32768,
            "minimum": 1,
            "title": "Outerheight",
            "type": "integer"
          },
          "devicePixelRatio": {
            "default": 1.0,
            "maximum": 16,
            "minimum": 0.1,
            "title": "Devicepixelratio",
            "type": "number"
          },
          "screenX": {
            "default": 0,
            "title": "Screenx",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenY": {
            "default": 0,
            "title": "Screeny",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenLeft": {
            "default": 0,
            "title": "Screenleft",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenTop": {
            "default": 0,
            "title": "Screentop",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageXOffset": {
            "default": 0,
            "title": "Pagexoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageYOffset": {
            "default": 0,
            "title": "Pageyoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "title": "Window",
        "type": "object"
      },
      "ShapeRequest": {
        "additionalProperties": false,
        "properties": {
          "source_url": {
            "title": "Source Url",
            "type": "string",
            "description": "Context only; never fetched. Required for uploads and references; must match cached source URL."
          },
          "scripts": {
            "items": {
              "$ref": "#/components/schemas/Script"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "description": "Ordered client-supplied scripts. At most 16; 2 MiB each and 3 MiB total UTF-8 source."
          },
          "material_ref": {
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/BrowserProfile"
          },
          "request": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "document_cookie": {
            "default": "",
            "title": "Document Cookie",
            "type": "string",
            "description": "JavaScript-visible cookies only, at most 16 KiB; never retained in material cache."
          }
        },
        "required": [
          "source_url",
          "profile",
          "request"
        ],
        "title": "ShapeRequest",
        "type": "object",
        "oneOf": [
          {
            "required": [
              "scripts"
            ],
            "not": {
              "required": [
                "material_ref"
              ]
            }
          },
          {
            "required": [
              "material_ref"
            ],
            "not": {
              "required": [
                "scripts"
              ]
            }
          }
        ]
      },
      "ShapeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headers",
          "request_id",
          "generation_ms",
          "profile_used",
          "material_ref",
          "material_expires_at"
        ],
        "properties": {
          "headers": {
            "type": "object",
            "minProperties": 6,
            "maxProperties": 6,
            "patternProperties": {
              "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}-[abcdfz]$": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Complete customer-specific same-prefix a/b/c/d/f/z family. Header names use valid HTTP token characters and need no X- prefix. Values contain only ASCII bytes 0x21 through 0x7e with no whitespace; d may be empty. Generation does not assert target acceptance."
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "generation_ms": {
            "type": "integer",
            "minimum": 0
          },
          "profile_used": {
            "$ref": "#/components/schemas/BrowserProfile",
            "description": "Effective supported browser identity; canvas pixels and document cookies are excluded."
          },
          "material_ref": {
            "type": "string"
          },
          "material_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Five-minute immutable material expiry, UTC. References are scoped to this API key."
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "daily_used",
          "monthly_used",
          "limits",
          "resets_at"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "daily_used": {
            "type": "integer",
            "minimum": 0
          },
          "monthly_used": {
            "type": "integer",
            "minimum": 0
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rpm",
              "burst",
              "daily_quota",
              "monthly_quota",
              "concurrency"
            ],
            "properties": {
              "rpm": {
                "type": "integer",
                "minimum": 1
              },
              "burst": {
                "type": "integer",
                "minimum": 1
              },
              "daily_quota": {
                "type": "integer",
                "minimum": 1
              },
              "monthly_quota": {
                "type": "integer",
                "minimum": 1
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "resets_at": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "daily",
              "monthly"
            ],
            "properties": {
              "daily": {
                "type": "string",
                "format": "date-time"
              },
              "monthly": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
