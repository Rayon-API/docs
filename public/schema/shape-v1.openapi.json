          },
          "navigator": {
            "$ref": "#/components/schemas/Navigator"
          }
        },
        "title": "BrowserProfile",
        "type": "object"
      },
      "Canvas": {
        "additionalProperties": false,
        "properties": {
          "data_url": {
            "default": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGNgAAIAAAUAAXpeqz8AAAAASUVORK5CYII=",
            "title": "Data Url",
            "type": "string",
            "description": "Valid PNG data URL with bounded strict base64, CRC-checked chunks and image stream; each dimension at most 8192, at most 16 Mi pixels. Full effective profile stays within 64 KiB UTF-8."
          }
        },
        "title": "Canvas",
        "type": "object"
      },
      "Navigator": {
        "additionalProperties": false,
        "properties": {
          "userAgent": {
            "default": "Mozilla/5.0",
            "maxLength": 8192,
            "title": "Useragent",
            "type": "string"
          },
          "platform": {
            "default": "MacIntel",
            "maxLength": 8192,
            "title": "Platform",
            "type": "string"
          },
          "vendor": {
            "default": "Google Inc.",
            "maxLength": 8192,
            "title": "Vendor",
            "type": "string"
          },
          "appVersion": {
            "default": "5.0",
            "maxLength": 8192,
            "title": "Appversion",
            "type": "string"
          },
          "appCodeName": {
            "default": "Mozilla",
            "maxLength": 8192,
            "title": "Appcodename",
            "type": "string"
          },
          "appName": {
            "default": "Netscape",
            "maxLength": 8192,
            "title": "Appname",
            "type": "string"
          },
          "product": {
            "default": "Gecko",
            "maxLength": 8192,
            "title": "Product",
            "type": "string"
          },
          "language": {
            "default": "en-US",
            "maxLength": 8192,
            "title": "Language",
            "type": "string"
          },
          "languages": {
            "default": [
              "en-US",
              "en"
            ],
            "items": {
              "maxLength": 8192,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Languages",
            "type": "array"
          },
          "hardwareConcurrency": {
            "default": 8,
            "maximum": 1024,
            "minimum": 1,
            "title": "Hardwareconcurrency",
            "type": "integer"
          },
          "maxTouchPoints": {
            "default": 0,
            "maximum": 100,
            "minimum": 0,
            "title": "Maxtouchpoints",
            "type": "integer"
          },
          "webdriver": {
            "default": false,
            "title": "Webdriver",
            "type": "boolean"
          },
          "cookieEnabled": {
            "default": true,
            "title": "Cookieenabled",
            "type": "boolean"
          },
          "doNotTrack": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Donottrack"
          }
        },
        "title": "Navigator",
        "type": "object"
      },
      "RequestContext": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "content_type": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          }
        },
        "required": [
          "url",
          "method",
          "content_type",
          "body"
        ],
        "title": "RequestContext",
        "type": "object"
      },
      "Screen": {
        "additionalProperties": false,
        "properties": {
          "width": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Width",
            "type": "integer"
          },
          "height": {
            "default": 1080,
            "maximum": 32768,
            "minimum": 1,
            "title": "Height",
            "type": "integer"
          },
          "availWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 0,
            "title": "Availwidth",
            "type": "integer"
          },
          "availHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 0,
            "title": "Availheight",
            "type": "integer"
          },
          "colorDepth": {
            "default": 24,
            "maximum": 64,
            "minimum": 1,
            "title": "Colordepth",
            "type": "integer"
          },
          "pixelDepth": {
            "default": 24,
            "maximum": 64,
            "minimum": 1,
            "title": "Pixeldepth",
            "type": "integer"
          }
        },
        "title": "Screen",
        "type": "object"
      },
      "Script": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "url",
          "source"
        ],
        "title": "Script",
        "type": "object"
      },
      "WebGL": {
        "additionalProperties": false,
        "properties": {
          "renderer": {
            "default": "Sandbox Renderer",
            "maxLength": 8192,
            "title": "Renderer",
            "type": "string"
          },
          "vendor": {
            "default": "Google Inc.",
            "maxLength": 8192,
            "title": "Vendor",
            "type": "string"
          }
        },
        "title": "WebGL",
        "type": "object"
      },
      "Window": {
        "additionalProperties": false,
        "properties": {
          "innerWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Innerwidth",
            "type": "integer"
          },
          "innerHeight": {
            "default": 1040,
            "maximum": 32768,
            "minimum": 1,
            "title": "Innerheight",
            "type": "integer"
          },
          "outerWidth": {
            "default": 1920,
            "maximum": 32768,
            "minimum": 1,
            "title": "Outerwidth",
            "type": "integer"
          },
          "outerHeight": {
            "default": 1080,
            "maximum": 32768,
            "minimum": 1,
            "title": "Outerheight",
            "type": "integer"
          },
          "devicePixelRatio": {
            "default": 1.0,
            "maximum": 16,
            "minimum": 0.1,
            "title": "Devicepixelratio",
            "type": "number"
          },
          "screenX": {
            "default": 0,
            "title": "Screenx",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenY": {
            "default": 0,
            "title": "Screeny",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenLeft": {
            "default": 0,
            "title": "Screenleft",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "screenTop": {
            "default": 0,
            "title": "Screentop",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageXOffset": {
            "default": 0,
            "title": "Pagexoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pageYOffset": {
            "default": 0,
            "title": "Pageyoffset",
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        },
        "title": "Window",
        "type": "object"
      },
      "ShapeRequest": {
        "additionalProperties": false,
        "properties": {
          "source_url": {
            "title": "Source Url",
            "type": "string",
            "description": "Context only; never fetched. Required for uploads and references; must match cached source URL."
          },
          "scripts": {
            "items": {
              "$ref": "#/components/schemas/Script"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "description": "Ordered client-supplied scripts. At most 16; 2 MiB each and 3 MiB total UTF-8 source."
          },
          "material_ref": {
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/BrowserProfile"
          },
          "request": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "document_cookie": {
            "default": "",
            "title": "Document Cookie",
            "type": "string",
            "description": "JavaScript-visible cookies only, at most 16 KiB; never retained in material cache."
          },
          "mode": {
            "type": "string",
            "enum": [
              "header",
              "form"
            ],
            "default": "header",
            "description": "Header mode (the default) returns HTTP telemetry headers. Form mode runs form instrumentation and returns body fields."
          },
          "form": {
            "$ref": "#/components/schemas/FormContext",
            "description": "Form mode only. Optional observed form ID and name; omitting this object creates the selected form without either attribute."
          }
        },
        "required": [
          "source_url",
          "profile",
          "request"
        ],
        "title": "ShapeRequest",
        "type": "object",
        "oneOf": [
          {
            "required": [
              "scripts"
            ],
            "not": {
              "required": [
                "material_ref"
              ]
            }
          },
          {
            "required": [
              "material_ref"
            ],
            "not": {
              "required": [
                "scripts"
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "form"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "request": {
                  "properties": {
                    "method": {
                      "const": "POST"
                    },
                    "content_type": {
                      "type": "string",
                      "description": "application/x-www-form-urlencoded, optionally with one UTF-8 charset parameter."
                    },
                    "body": {
                      "type": "string",
                      "description": "Exact encoded application body before telemetry insertion; an empty string is permitted. At most 256 KiB UTF-8, 1,024 decoded pairs and 256 UTF-8 bytes per field name. Preserve duplicate fields, order and empty values. Malformed percent escapes, invalid UTF-8, NUL and a complete stale telemetry family are rejected."
                    }
                  }
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "form"
                ]
              }
            }
          }
        ]
      },
      "ShapeResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/HeaderShapeResponse"
          },
          {
            "$ref": "#/components/schemas/FormShapeResponse"
          }
        ],
        "description": "Transport-specific output: header and form properties are mutually exclusive. Metadata meanings are unchanged. Generation does not establish target acceptance."
      },
      "UsageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "limits",
          "allowance"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "daily_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Legacy admitted-attempt analytics only; no daily or monthly cap is enforced.",
            "deprecated": true
          },
          "monthly_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Legacy admitted-attempt analytics only; no daily or monthly cap is enforced.",
            "deprecated": true
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requests_per_second"
            ],
            "properties": {
              "requests_per_second": {
                "type": "number",
                "maximum": 15,
                "exclusiveMinimum": 0,
                "description": "Effective account-wide rate, including an active trial cap. Trial expiry/exhaustion restores base limits."
              }
            }
          },
          "allowance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "weekly_limit",
              "weekly_used",
              "weekly_remaining",
              "weekly_resets_at",
              "prepaid_remaining",
              "wallet",
              "payg_rate_per_1000_usd"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "owner",
                  "custom",
                  "subscription",
                  "prepaid",
                  "wallet"
                ]
              },
              "weekly_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "weekly_used": {
                "type": "integer",
                "minimum": 0,
                "description": "Spent and currently reserved calls in the current allowance period."
              },
              "weekly_remaining": {
                "type": "integer",
                "minimum": 0
              },
              "weekly_resets_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "prepaid_remaining": {
                "type": "integer",
                "minimum": 0,
                "description": "Deprecated standard-rate call equivalent of available wallet funds ($5 per 1,000); use wallet.balance_usd and the current PAYG rate. Deferred legacy conversions may still expose their original call count.",
                "deprecated": true
              },
              "wallet": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "balance_usd",
                  "balance_micro_usd"
                ],
                "properties": {
                  "balance_usd": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Available preloaded USD wallet funds."
                  },
                  "balance_micro_usd": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Exact available balance in millionths of one USD."
                  }
                }
              },
              "payg_rate_per_1000_usd": {
                "type": "number",
                "enum": [
                  5,
                  3.5,
                  2.5,
                  2,
                  1.5
                ],
                "description": "Standard PAYG or the newest eligible paid period rate per 1,000 successful generations, after weekly allowance."
              },
              "legacy_prepaid_deprecated": {
                "type": "boolean",
                "const": true,
