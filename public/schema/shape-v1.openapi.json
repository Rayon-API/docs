            "default": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGNgAAIAAAUAAXpeqz8AAAAASUVORK5CYII=",
            "title": "Data Url",
            "type": "string",
            "description": "Valid PNG data URL with bounded strict base64, CRC-checked chunks and image stream; each dimension at most 8192, at most 16 Mi pixels. Full effective profile stays within 64 KiB UTF-8."
          }
        },
        "title": "Canvas",
        "type": "object"
      },
      "Navigator": {
        "additionalProperties": false,
